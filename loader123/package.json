{
  "name": "excel-client-launcher",
  "version": "1.0.17",
  "description": "Excel Client Launcher",
  "main": "app.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build-installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.excel.client.launcher",
    "productName": "Excel Client",
    "icon": "excel.ico",
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Excel Client",
      "artifactName": "ExcelClientSetup.exe",
      "installerIcon": "excel.ico",
      "uninstallerIcon": "excel.ico",
      "installerHeaderIcon": "excel.ico"
    },
    "files": [
      "**/*",
      "!node_modules/.cache"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "rcedit": "^5.0.2"
  }
}
